.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/
.fvm/
*.symbols
*.map.json
app.*.symbols
app.*.map.json
*_web_entrypoint.dart

